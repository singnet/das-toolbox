#!/usr/bin/make -f

ROOT_DIR := $(patsubst %/,%,$(dir $(CURDIR)))
DEB_SOURCE := das-toolbox
ARTIFACTS_DIR := $(ROOT_DIR)/dist
USR_BIN_DIR := $(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/usr/bin
BASH_COMPLETION_DIR := $(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/etc/bash_completion.d
ZSH_COMPLETION_DIR := $(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/usr/share/zsh/site-functions
USR_LIBS_DIR := $(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/usr/lib/$(DEB_SOURCE)
TEMP_DIR := $(shell mktemp -d)
CLI_BUILD_HOME := $(TEMP_DIR)/cli-home
DAS_REPO_URL ?= https://github.com/singnet/das.git
DAS_REPO_REF ?= master

ifeq ($(PACKAGE_VERSION),)
$(error The PACKAGE_VERSION environment variable is not defined. Please define it before continuing.)
endif

%:
	dh $@

override_dh_shlibdeps:
	dh_shlibdeps -l$(USR_LIBS_DIR)

override_dh_builddeb: build_man_pages build_autocomplete
	dh_builddeb
	cp ../*.deb $(ARTIFACTS_DIR)

override_dh_auto_install:
	pip3 install pyinstaller==6.3.0

	# Install dependencies for das-cli
	pip3 install -r $(ROOT_DIR)/das-cli/src/requirements.txt

	# Install gatekeeper dependencies
	pip3 install -r $(ROOT_DIR)/gatekeeper/api/requirements.txt
	pip3 install -r $(ROOT_DIR)/gatekeeper/cli/requirements.txt

	# Build das-cli
	pyinstaller $(ROOT_DIR)/das-cli/src/das_cli.py -y -F -n das-cli --distpath $(ARTIFACTS_DIR)

	# Build gatekeeper
	pyinstaller $(ROOT_DIR)/gatekeeper/api/src/main.py -y -F -n gk-server --distpath $(ARTIFACTS_DIR)
	pyinstaller $(ROOT_DIR)/gatekeeper/cli/src/main.py -y -F -n gkctl --distpath $(ARTIFACTS_DIR)

	# Copy all binaries
	mkdir -p $(USR_BIN_DIR) $(USR_LIBS_DIR)
	find $(ARTIFACTS_DIR) -maxdepth 1 -type f ! -name "*.*" -executable -exec cp {} $(USR_BIN_DIR) \;

	# Install default DAS configuration
	set -e; \
	DAS_CLONE_DIR="$$(mktemp -d)"; \
	trap 'rm -rf "$$DAS_CLONE_DIR"' EXIT; \
	git clone --depth 1 --branch "$(DAS_REPO_REF)" "$(DAS_REPO_URL)" "$$DAS_CLONE_DIR"; \
	test -f "$$DAS_CLONE_DIR/config/das.json"; \
	install -D -m 0644 \
		"$$DAS_CLONE_DIR/config/das.json" \
		"$(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/usr/share/das/config.json"

build_man_pages:
	PYTHONPATH=$(ROOT_DIR)/das-cli/src python3 $(ROOT_DIR)/das-cli/setup.py --command-packages=click_man.commands man_pages --target $(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/usr/share/man/man1/
	@for file in $(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/usr/share/man/man1/*; do \
		gzip -c $$file > $$file.gz; \
		rm $$file; \
	done

build_autocomplete:
	@echo "Generating autocompletion scripts..."
	mkdir -p $(BASH_COMPLETION_DIR) $(ZSH_COMPLETION_DIR)
	@set -e; \
	mkdir -p "$(CLI_BUILD_HOME)/.das"; \
	if [ -f "$(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/usr/share/das/config.json" ]; then \
		cp "$(ROOT_DIR)/pkg/debian/$(DEB_SOURCE)/usr/share/das/config.json" "$(CLI_BUILD_HOME)/.das/config.json"; \
	else \
		DAS_CLONE_DIR="$$(mktemp -d)"; \
		trap 'rm -rf "$$DAS_CLONE_DIR"' EXIT; \
		git clone --depth 1 --branch "$(DAS_REPO_REF)" "$(DAS_REPO_URL)" "$$DAS_CLONE_DIR"; \
		test -f "$$DAS_CLONE_DIR/config/das.json"; \
		cp "$$DAS_CLONE_DIR/config/das.json" "$(CLI_BUILD_HOME)/.das/config.json"; \
	fi; \
	HOME="$(CLI_BUILD_HOME)" _DAS_CLI_COMPLETE=bash_source $(ARTIFACTS_DIR)/das-cli > $(BASH_COMPLETION_DIR)/das-cli.bash; \
	HOME="$(CLI_BUILD_HOME)" _DAS_CLI_COMPLETE=zsh_source $(ARTIFACTS_DIR)/das-cli > $(ZSH_COMPLETION_DIR)/_das-cli
